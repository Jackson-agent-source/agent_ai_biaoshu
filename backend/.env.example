# ============================================================
# 后端环境变量模板
#
# 使用方法：
#   1. 复制这个文件为 .env       ->  cp .env.example .env
#   2. 把下面需要填的项填上（至少 LLM_API_KEY 和 LLM_MODEL）
#   3. .env 已经被 .gitignore 忽略，不会被提交到 Git，请放心填写密钥
# ============================================================

# ---------- Django ----------
DEBUG=True
# 生产环境务必换成随机字符串，例如用：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# mysql  = 正式方案，需要 MySQL 8.0.11 或更高版本（Django 5.2 的最低要求）
# sqlite = 兜底方案，零配置，先把项目跑起来用
DB_ENGINE=mysql
DB_NAME=ai_content_agent
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------- 大模型 ----------
# provider 名称，例如 openai / deepseek / qwen / anthropic
# 只要你的服务兼容 OpenAI 接口，就填 openai，然后用 LLM_BASE_URL 指向你的服务
LLM_PROVIDER=openai
# 模型名，例如 gpt-4o-mini / deepseek-chat / qwen-plus
LLM_MODEL=
# 你的 API Key（不要提交到 Git！）
LLM_API_KEY=
# 自定义服务地址。用官方 OpenAI 就留空；用国内兼容服务就填，例如：
#   https://api.deepseek.com/v1
#   https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ---------- 联网搜索 ----------
# 可选 tavily / google。留空则 web_search 返回"搜索未配置"，
# Agent 会基于已有信息写作，并在风险提示里说明资料受限。
#
# ── 推荐：Tavily（注册简单，只要一个凭据）────────────────────
#   SEARCH_PROVIDER=tavily
#   SEARCH_API_KEY=你的 API Key
#   去 https://tavily.com 注册即可，免费额度够个人开发用。
#   它自带英文索引，配合 prompt 里的"英文优先"策略足够用了。
#
# ── 不推荐：Google（正在下线，只留给存量用户）────────────────
#   ⚠️ 2026-01-20 起，新建的搜索引擎**不能再搜整个网络**，最多 50 个域名；
#      Custom Search JSON API 也已不再接受新用户，2027-01-01 关停。
#      只有当年申请到「搜索整个网络」引擎的存量账号还能用。
#   如果**你确实有**这样的存量引擎，才这样配：
#     SEARCH_PROVIDER=google
#     SEARCH_API_KEY=你的 API Key        ← console.cloud.google.com/apis/credentials
#     SEARCH_ENGINE_ID=你的 cx
#     并且记得清空 SEARCH_BASE_URL
#
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# 热点选题：Google、BBC、Guardian、Hacker News 无需密钥；GitHub 可匿名访问。
TREND_GOOGLE_GEO=US
TREND_GITHUB_TOKEN=
# Gitee 搜索接口可匿名请求；令牌可选，失败会在页面显示。
TREND_GITEE_TOKEN=
TREND_YOUTUBE_API_KEY=
TREND_YOUTUBE_REGION=US
TREND_X_BEARER_TOKEN=
TREND_X_WOEID=1
TREND_DOUYIN_CLIENT_KEY=
TREND_DOUYIN_CLIENT_SECRET=
# 可选：只推荐含这些词的热点，英文逗号分隔；留空表示不限领域。
TREND_KEYWORDS=
# 多用户时按用户名分别生成选题和草稿；留空时可用单用户 ID。
TREND_USERNAMES=
TREND_USER_ID=0
# 默认每天自动生成至多 1 篇站内草稿；不需要时改为 False。
TREND_AUTO_GENERATE=True
TREND_DAILY_ARTICLE_LIMIT=1
TREND_FETCH_TIMEOUT=15
TREND_INTERVAL_SECONDS=21600
# 仅用于 trend_scheduler.sh；本地需通过任务计划或手动启动脚本。
THROTTLE_TREND_REFRESH=3/hour
SEARCH_ENGINE_ID=
# 留空即用各家默认地址，一般不用填
SEARCH_BASE_URL=
SEARCH_TIMEOUT=20
# 结果语言限制（对应 Google 的 lr 参数）。留空 = 不限制，
# 由模型自己决定用英文还是中文提问（prompt 里已经要求英文为主）。
# 填 lang_en 就是硬性只要英文网页，中文提问也基本只返回英文结果。
SEARCH_LANGUAGE=

# ---------- AI 配图（文生图）----------
# 文章的配图走 OpenAI 兼容的 /images/generations 协议，
# 所以可以直接对接**中转站**（one-api / new-api 那一类）。
#
# ★ 下面这三项**缺一不可**，而且代码刻意**不会**回退到 OpenAI 官方地址 ——
#   中转站的域名每家都不同，给个默认值只会让人更迷惑。
#   缺任何一项时不会报 500，而是返回一句"缺了哪几项"的中文提示。
IMAGE_API_KEY=
# 中转站的 /v1 地址。结尾带不带斜杠都行（代码会去掉）。
#   例：https://your-relay.example.com/v1
IMAGE_BASE_URL=
# ★ 必须是中转站支持的**生图**模型名，注意生图和对话是两套模型。
#   填错时会明确提示"模型不存在，请去中转站后台确认"。
IMAGE_MODEL=
# 单张图的超时（秒）。生图本身就要 30~90 秒，别往小调。
IMAGE_TIMEOUT=300
# 出图尺寸。横版 —— 和 settings.py 里画风提示词的"构图为横版"配套，
# 改一个就得改另一个，否则模型收到自相矛盾的指令。
# 封面不受这个值影响 —— 代码会自己裁成 900x500。
IMAGE_SIZE=1536x1024
# quality / output_format 只有 gpt-image-* 系列认，老模型带了会直接 400。
# 代码会先判断模型名再决定带不带，照填即可。
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=jpeg
# 画风前缀，会拼在每条配图建议前面。
# ★ 默认值（科技杂志编辑插画风）写在 config/settings.py 的 IMAGE_STYLE_PROMPT 里，
#   想换画风在这里取消注释覆盖即可。留空/注释掉 = 用 settings.py 的默认值。
# ★ 只能写单行：换行会被截断，多行需求请改 settings.py（那边可以保留多行）。
# ★ 别用 "#"：后面会被当注释吃掉，整个值从那里断掉。
# IMAGE_STYLE_PROMPT=
# 单篇文章的配图上限（防止一篇文章被塞进几十张图）。0 = 不限制。
IMAGE_MAX_PER_ARTICLE=8
# 每日配图额度。0 = 不限制（本地开发用默认值即可）。
# 放到公网请务必设一个非 0 的值，理由和 AGENT_DAILY_QUOTA_* 一样：
# 真正防烧钱的是"每天总共生成几张"这个总量账本，频率限流挡不住。
IMAGE_DAILY_QUOTA_PER_USER=0
IMAGE_DAILY_QUOTA_GLOBAL=0

# ---------- 微信公众号（推送草稿箱）----------
# 公众号后台 → 设置与开发 → 基本配置 里拿这两个值。
#
# ★★ 同一个页面里的 **IP 白名单**必须加上服务器的公网 IP，
#    否则所有接口都会返回 40164，代码层面无解。
#
# ★ 本项目做的是**建草稿**，不是发布。个人主体订阅号从 2025-07 起
#   拿不到 freepublish/submit 权限，API 层面就发不出去 ——
#   只能建草稿，由人在草稿箱里手动点发布。
#   本地开发不推公众号的话，下面留空即可。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 微信接口超时（秒）。上传正文图/封面要传几百 KB，别设太小。
WECHAT_TIMEOUT=60
# 草稿的"作者"字段。留空就是不带作者，微信允许。
WECHAT_AUTHOR=

# ---------- Agent 防失控限制 ----------
# 一次生成最多允许调用多少次工具（超过就停止研究，用现有资料写作）
MAX_TOOL_CALLS=8
# web_search 单次最多返回多少条结果（硬上限 10）
MAX_SEARCH_RESULTS=5
# read_webpage 提取正文后最多保留多少字符
MAX_WEBPAGE_CHARS=20000
# 用户输入总长度上限
MAX_USER_PROMPT_CHARS=5000
# LangGraph 递归上限，最后的兜底保护
AGENT_RECURSION_LIMIT=30
# 抓网页的超时 / 最大体积 / 最大重定向次数
WEBPAGE_FETCH_TIMEOUT=15
WEBPAGE_MAX_BYTES=2000000
WEBPAGE_MAX_REDIRECTS=3

# ---------- 日志 ----------
LOG_LEVEL=INFO

# Optional independent secret for encrypting per-account API keys stored in the database.
# If blank, Django SECRET_KEY is used. Back up this secret with the database;
# changing it requires users to re-enter their saved API keys.
MODEL_CREDENTIAL_SECRET=
