# ============================================================
# 后端环境变量模板
#
# 使用方法：
#   1. 复制这个文件为 .env       ->  cp .env.example .env
#   2. 把下面需要填的项填上（至少 LLM_API_KEY 和 LLM_MODEL）
#   3. .env 已经被 .gitignore 忽略，不会被提交到 Git，请放心填写密钥
# ============================================================

# ---------- Django ----------
DEBUG=True
# 生产环境务必换成随机字符串，例如用：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# mysql  = 正式方案，需要 MySQL 8.0.11 或更高版本（Django 5.2 的最低要求）
# sqlite = 兜底方案，零配置，先把项目跑起来用
DB_ENGINE=mysql
DB_NAME=ai_content_agent
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# ---------- 大模型 ----------
# provider 名称，例如 openai / deepseek / qwen / anthropic
# 只要你的服务兼容 OpenAI 接口，就填 openai，然后用 LLM_BASE_URL 指向你的服务
LLM_PROVIDER=openai
# 模型名，例如 gpt-4o-mini / deepseek-chat / qwen-plus
LLM_MODEL=
# 你的 API Key（不要提交到 Git！）
LLM_API_KEY=
# 自定义服务地址。用官方 OpenAI 就留空；用国内兼容服务就填，例如：
#   https://api.deepseek.com/v1
#   https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# ---------- 联网搜索 ----------
# 可选 tavily / google。留空则 web_search 返回"搜索未配置"，
# Agent 会基于已有信息写作，并在风险提示里说明资料受限。
#
# ── 推荐：Tavily（注册简单，只要一个凭据）────────────────────
#   SEARCH_PROVIDER=tavily
#   SEARCH_API_KEY=你的 API Key
#   去 https://tavily.com 注册即可，免费额度够个人开发用。
#   它自带英文索引，配合 prompt 里的"英文优先"策略足够用了。
#
# ── 不推荐：Google（正在下线，只留给存量用户）────────────────
#   ⚠️ 2026-01-20 起，新建的搜索引擎**不能再搜整个网络**，最多 50 个域名；
#      Custom Search JSON API 也已不再接受新用户，2027-01-01 关停。
#      只有当年申请到「搜索整个网络」引擎的存量账号还能用。
#   如果**你确实有**这样的存量引擎，才这样配：
#     SEARCH_PROVIDER=google
#     SEARCH_API_KEY=你的 API Key        ← console.cloud.google.com/apis/credentials
#     SEARCH_ENGINE_ID=你的 cx
#     并且记得清空 SEARCH_BASE_URL
#
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
# 留空即用各家默认地址，一般不用填
SEARCH_BASE_URL=
SEARCH_TIMEOUT=20
# 结果语言限制（对应 Google 的 lr 参数）。留空 = 不限制，
# 由模型自己决定用英文还是中文提问（prompt 里已经要求英文为主）。
# 填 lang_en 就是硬性只要英文网页，中文提问也基本只返回英文结果。
SEARCH_LANGUAGE=

# ---------- Agent 防失控限制 ----------
# 一次生成最多允许调用多少次工具（超过就停止研究，用现有资料写作）
MAX_TOOL_CALLS=8
# web_search 单次最多返回多少条结果（硬上限 10）
MAX_SEARCH_RESULTS=5
# read_webpage 提取正文后最多保留多少字符
MAX_WEBPAGE_CHARS=20000
# 用户输入总长度上限
MAX_USER_PROMPT_CHARS=5000
# LangGraph 递归上限，最后的兜底保护
AGENT_RECURSION_LIMIT=30
# 抓网页的超时 / 最大体积 / 最大重定向次数
WEBPAGE_FETCH_TIMEOUT=15
WEBPAGE_MAX_BYTES=2000000
WEBPAGE_MAX_REDIRECTS=3

# ---------- 日志 ----------
LOG_LEVEL=INFO
