# ============================================================
# 服务器部署配置模板
#
# 使用方法（在服务器上，仓库根目录）：
#     cp .env.deploy.example .env
#     chmod 600 .env
#     然后按下面的说明逐项改掉 → docker compose up -d --build
#
# ★★★ 这个文件是模板，可以提交到 Git。
#     **真正的 .env 绝对不能提交** —— 它已经被 .gitignore 忽略了。
#     一旦密钥进了 Git 历史，即使之后删除也依然能翻出来，
#     必须视为"已经泄漏"，只能去服务商后台吊销重发。
#
# ★ 这是项目里**唯一**一份配置。不要再建 backend/.env ——
#   两处配置一定会写岔，而且排查问题时你会先看错的那一份。
# ============================================================


# ------------------------------------------------------------
# 对外端口（★ 装了宝塔的话这一节必看）
# ------------------------------------------------------------
# ★ 默认 8080，不是 80。
#
#   宝塔面板装完会自带一个 nginx 占着 80 端口。如果你把这里设成 80，
#   docker compose up 会直接失败：
#       Bind for 0.0.0.0:80 failed: port is already allocated
#
#   用 8080 就完全不用动宝塔，浏览器访问 http://<公网IP>:8080 即可。
WEB_PORT=8080

# 监听地址，只有两个合法值：
#
#   0.0.0.0   直接对外。浏览器访问 http://<公网IP>:8080
#             —— 第一次部署先用这个，能跑通再说别的。
#
#   127.0.0.1 只有本机能连，外面连不上。
#             然后在宝塔里加一个反向代理指向 http://127.0.0.1:8080，
#             浏览器就能直接访问 http://<公网IP>（不带端口号）。
#             ★ 好处：地址干净，而且将来买了域名可以直接用宝塔的
#               SSL 一键上 HTTPS，不用改我们这边的任何配置。
WEB_BIND=0.0.0.0


# ------------------------------------------------------------
# Django 基础
# ------------------------------------------------------------
# ★★★ 必须是 False。
#   DEBUG=True 时 Django 会把完整的 settings、源码路径、环境变量
#   渲染到错误页面上。公网任何人触发一个报错就能看到这些。
DEBUG=False

# ★★★ 必须换掉，脚本会检查这个值并拒绝用默认值启动。
#   生成一个：openssl rand -base64 48
DJANGO_SECRET_KEY=change-me-to-a-random-string

# ★★★ 换成你的公网 IP。
#
#   ★ 必须保留 127.0.0.1：容器里的 healthcheck 请求的是
#     http://127.0.0.1:8000/health/，漏了它容器会一直是 unhealthy，
#     docker compose ps 里能看到，但不知道为什么。
#
#   ★ 不要图省事写 *：那等于关掉了 Host 头校验，
#     而且配置写错时会变得更难发现。
#
#   漏配的症状：Django 返回 400 "Invalid HTTP_HOST header"，
#   而且**不会告诉你它期望什么**，很难查。
ALLOWED_HOSTS=203.0.113.10,127.0.0.1,localhost

# ★★★ 必须带 http:// 前缀，写 http://203.0.113.10 而不是 203.0.113.10。
#   只写 IP 是**不生效**的，而且 Django 不会报错、只会默默拒绝 ——
#   表现是 /admin/ 登录时 403，很难查。
CSRF_TRUSTED_ORIGINS=http://203.0.113.10

# 前后端由同一个 nginx 提供（同源），所以不需要 CORS。
# 留空即可；将来如果前端单独部署到别的域名，再往这里加。
CORS_ALLOWED_ORIGINS=

# 网站前端的对外地址。只被后端根路径那句 JSON 提示语用到来拼提示。
SITE_ORIGIN=http://203.0.113.10

# 现在是纯 HTTP，必须 False。
# ★ 将来买了域名 + 配好 HTTPS 之后，把这里改成 True，
#   settings.py 里的 SECURE_SSL_REDIRECT / Cookie Secure / HSTS
#   会一次性全部生效，代码一个字都不用改。
USE_HTTPS=False


# ------------------------------------------------------------
# 后台地址
# ------------------------------------------------------------
# ★ 换成一个别人猜不到的路径（结尾要带斜杠）。
#   /admin/ 是所有扫描器的第一个探测目标，换掉之后它们连门都找不到。
#   改了之后记得用新地址访问后台。
ADMIN_URL_PATH=manage-8f3a91c7/


# ------------------------------------------------------------
# 数据库
# ------------------------------------------------------------
DB_ENGINE=mysql
DB_NAME=ai_content_agent
DB_USER=agent

# ★★★ 换成强密码。生成：openssl rand -base64 32 | tr -d '/+='
#
# ★ 密码里请**避开 $ 符号**：docker compose 会对 .env 做变量展开，
#   P@ss$word 里的 $word 会被当成变量替换成空字符串，密码就悄悄变了，
#   然后你会看到一个莫名其妙的"Access denied"。
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password

# ★ 这是 compose 里数据库服务的名字，**不是** 127.0.0.1。
#   容器之间通过服务名互相访问。写 127.0.0.1 会连到容器自己身上，必失败。
DB_HOST=db
DB_PORT=3306


# ------------------------------------------------------------
# 大模型
# ------------------------------------------------------------
# ★ 换模型 / 换厂商只需要改这几行，不用动任何代码。
#
# 注意：本项目依赖"工具调用 / function calling"能力。
#       DeepSeek 必须用 deepseek-chat（V3），
#       不要用 deepseek-reasoner（R1）—— R1 是推理模型，
#       不支持 function calling，Agent 会完全没法调用工具。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

LLM_TEMPERATURE=0.4
# 单次模型调用的超时（秒）。这个值要和 nginx 的 proxy_read_timeout 一起看：
# nginx 那边是 600 秒，会给足余量。
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2


# ------------------------------------------------------------
# 联网搜索
# ------------------------------------------------------------
# 可选 tavily / google。
#
# ★ 推荐 Tavily：注册简单，只要一个凭据，自带英文索引。
#
# ★ 不要再选 Google 了：Google 已于 2026-01-20 取消「搜索整个网络」，
#   新建的搜索引擎最多只能覆盖 50 个域名；Custom Search JSON API
#   也不再接受新用户（2027-01-01 关停）。
#   这是账号级别的限制，改 API 限制、重新申请 Key、新建项目都没有用。
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT=20
SEARCH_LANGUAGE=


# ------------------------------------------------------------
# 防烧钱（★ 这一节看仔细，直接关系到你的钱包）
# ------------------------------------------------------------
# ★ 关掉自助注册。
#   开着的话，公网上的陌生人注册之后就能用**你的** LLM_API_KEY 生成文章，
#   这钱是你出的。关掉之后账号由管理员创建：
#       docker compose exec backend python manage.py createsuperuser
#   之后也可以在后台继续加人。
ALLOW_REGISTRATION=False

# ---- 第一层：频率限流（挡"短时间狂点"）----
# 单用户提交生成的频率。别设太紧 —— 一次生成要跑 30~120 秒，
# 用户在等待期间刷新页面、点开历史列表都不该被误伤。
THROTTLE_GENERATE=10/hour
# 登录接口，防撞库
THROTTLE_LOGIN=20/min

# ---- 第二、三层：每日总量额度（挡"慢慢烧"）----
# ★ 这才是真正的钱包保险丝。
#
#   把额度刷光最典型的姿势不是"疯狂点按钮"（那会被上面的频率限流挡住），
#   而是"每天正常用，但每次都跑满 8 次工具调用 + 十几次大模型调用" ——
#   频率完全正常，只有自然日的总量账本挡得住。
#
#   这两个数字是"数数据库里真实有几条运行记录"，清缓存、重启、换 worker
#   都绕不过去，也没法用注册小号绕过（全局那条是算所有人的）。
#
#   0 = 不限制。按你的心理止损线来设。
#   单人每天最多生成几篇
AGENT_DAILY_QUOTA_PER_USER=20
# 全站每天总上限 —— 最坏情况下的损失上限就是这个数
AGENT_DAILY_QUOTA_GLOBAL=200


# ------------------------------------------------------------
# 缓存
# ------------------------------------------------------------
# locmem = 每个 gunicorn worker 各存一份限流计数。
#
# ★ 为什么不影响防烧钱：真正的保险丝是上面那两个每日额度，
#   它们直接数数据库行数，跟缓存完全无关，多 worker 也是准的。
#   频率限流只是第一道粗筛，内存版足够。
#
# 要精确的跨进程频率限流就改成 db（容器启动时会自动建表），
# 或者换成 Redis。改这一个值即可，代码不用动。
CACHES_BACKEND=locmem


# ------------------------------------------------------------
# Agent 运行限制（一般不用改）
# ------------------------------------------------------------
MAX_TOOL_CALLS=8
MAX_SEARCH_RESULTS=5
MAX_WEBPAGE_CHARS=20000
MAX_USER_PROMPT_CHARS=5000
AGENT_RECURSION_LIMIT=30
WEBPAGE_FETCH_TIMEOUT=15
WEBPAGE_MAX_BYTES=2000000
WEBPAGE_MAX_REDIRECTS=3


# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
LOG_LEVEL=INFO
