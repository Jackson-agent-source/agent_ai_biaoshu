# ============================================================
# 服务器部署配置模板
#
# 使用方法（在服务器上，仓库根目录）：
#     cp .env.deploy.example .env
#     chmod 600 .env
#     然后按下面的说明逐项改掉 → docker compose up -d --build
#
# ★★★ 这份模板假设你**已经有域名**，而且**前面有一层宝塔 nginx 做 HTTPS**。
#     我们这个栈只监听 127.0.0.1:8080，证书和 443 都归宝塔管。
#     完整步骤（建站点、反代、加请求头、一键 SSL）见 README 12.10。
#
#     ★ 如果那台机器上**只有这一个站**，也可以让容器自己终结 TLS，
#       但本文档走的是宝塔反代这条路 —— 因为实测那台机器上还有别的
#       网站在宝塔上，两个 nginx 抢 80/443 会把那个站一起搞挂。
#
# ★★★ 这个文件是模板，可以提交到 Git。
#     **真正的 .env 绝对不能提交** —— 它已经被 .gitignore 忽略了。
#     一旦密钥进了 Git 历史，即使之后删除也依然能翻出来，
#     必须视为"已经泄漏"，只能去服务商后台吊销重发。
#
# ★ 这是项目里**唯一**一份配置。不要再建 backend/.env ——
#   两处配置一定会写岔，而且排查问题时你会先看错的那一份。
# ============================================================


# ------------------------------------------------------------
# 域名 / HTTPS
# ------------------------------------------------------------
# ★★★ 这一节不是"可选的优化"。
#     不用 HTTPS，登录凭证就是**明文**在公网上跑的 —— token 存在浏览器
#     localStorage 里，每个请求都以 Authorization: Token xxx 明文发送，
#     同一个 WiFi 下谁都能抓走然后冒充你登录。而 HTTPS 需要域名。
#
#     ★ 这套部署里 TLS 由**宿主机上的宝塔 nginx** 终结，
#       我们的容器只监听 127.0.0.1:8080。所以这里**没有证书路径要填**，
#       域名的作用变成了三件事：
#         ① Django 的 ALLOWED_HOSTS / CSRF_TRUSTED_ORIGINS 校验
#         ② 拼配图的对外地址（MEDIA_PUBLIC_BASE_URL）
#         ③ 让 Django 知道"这个请求算 https"（靠宝塔传的请求头）
#       完整步骤见 README 12.10。

# 容器监听的宿主机端口。
#
# ★ 不要改成 80 —— 80 被宝塔的 nginx 占着，改了会报
#       Bind for 127.0.0.1:80 failed: port is already allocated
#   宝塔那边反向代理的目标就是 127.0.0.1:8080，两边必须对上。
WEB_PORT=8080

# 监听地址。**只允许 127.0.0.1**，不要改成 0.0.0.0。
#
# ★ 这是安全问题，不是洁癖：容器里的 nginx 会把宝塔传来的
#   X-Forwarded-Proto **原样透传**给 Django，Django 拿它判断
#   "这个请求算不算 https"。一旦这个端口能从公网直连，
#   任何人都能绕过宝塔、自己伪造一个 X-Forwarded-Proto: https，
#   让 Django 把一个明文请求当成加密请求处理。
#
# ★ 绑在回环地址上，8080 也因此**不用**在云安全组里放行。
WEB_BIND=127.0.0.1


# ------------------------------------------------------------
# Django 基础
# ------------------------------------------------------------
# ★★★ 必须是 False。
#   DEBUG=True 时 Django 会把完整的 settings、源码路径、环境变量
#   渲染到错误页面上。公网任何人触发一个报错就能看到这些。
DEBUG=False

# ★★★ 必须换掉，脚本会检查这个值并拒绝用默认值启动。
#   生成一个：openssl rand -base64 48
DJANGO_SECRET_KEY=change-me-to-a-random-string

# ★★★ 换成你的域名。
#
#   ★ 必须保留 127.0.0.1：容器里的 healthcheck 请求的是
#     http://127.0.0.1:8000/health/，漏了它容器会一直是 unhealthy，
#     docker compose ps 里能看到，但不知道为什么。
#
#   ★ 不要图省事写 *：那等于关掉了 Host 头校验，
#     而且配置写错时会变得更难发现。
#
#   漏配的症状：Django 返回 400 "Invalid HTTP_HOST header"，
#   而且**不会告诉你它期望什么**，很难查。
ALLOWED_HOSTS=example.com,127.0.0.1,localhost

# ★★★ 必须带 https:// 前缀。写 https://example.com 而不是 example.com。
#   只写域名是**不生效**的，而且 Django 不会报错、只会默默拒绝 ——
#   表现是 /后台路径/ 登录时 403，很难查。
CSRF_TRUSTED_ORIGINS=https://example.com

# 前后端由同一个 nginx 提供（同源），所以不需要 CORS。
# 留空即可；将来如果前端单独部署到别的域名，再往这里加。
CORS_ALLOWED_ORIGINS=

# 网站前端的对外地址。只被后端根路径那句 JSON 提示语用到来拼提示。
# ★ 就是 https://<域名>，**没有端口号**（443 是 https 的默认端口，不写）。
SITE_ORIGIN=https://example.com

# 配图的**对外**基地址，只给「复制到公众号」用。
#
# ★ 复制出去的 HTML 会被粘到 mp.weixin.qq.com 上，那里的相对路径会被解析成
#   mp.weixin.qq.com/media/... —— 所以必须给绝对地址，而绝对地址只能从
#   这里配（不能从请求头猜）。
#
# ★★ **必须和前后端同源**：就是 https://<域名>，不带端口号。
#
#   ★ 这一项配了 http:// 而页面是 https:// 的话，粘出去的图会被浏览器
#     按**混合内容**拦掉 —— 症状是"正文文字完全正常、图片全是裂的"。
#     上了 HTTPS 之后，这正是本项存在的意义。
#
# ★ 留空 = 复制时跳过所有配图并提示用户去配（宁可少图，也不要一墙裂图）。
#   纯文字复制不需要它，留空也能用。
MEDIA_PUBLIC_BASE_URL=https://example.com

# ★ 上了 HTTPS 就必须是 True，否则：
#   Cookie 不加 Secure、不做 HSTS、http 访问不会跳转 —— 等于 HTTPS 白配了。
#
#   打开之后 settings.py 里这一整块会一起生效：
#   SECURE_SSL_REDIRECT / SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE /
#   SECURE_PROXY_SSL_HEADER / HSTS。
#
#   ★ 前提是**外面真的有一层 HTTPS 终结**（这里是宝塔的站点配置）。
#     ★★ 而且宝塔那边必须发 X-Forwarded-Proto 请求头 —— 这是 Django
#        判断"请求算不算 https"的唯一依据（SECURE_PROXY_SSL_HEADER）。
#        少了它，Django 会把 https 的请求当成 http，然后 301 到 https，
#        绕回来还是被当成 http …… **无限重定向**，整站打不开。
#        配置方法见 README 12.10 **第 2 步**。
USE_HTTPS=True

# HSTS 的有效期（秒）。★ 先短后长。
#
#   第一次上线填 300（5 分钟）。跑一周没问题之后，改成 31536000（1 年）。
#
#   为什么不直接填一年：HSTS 本身不是不可逆的（浏览器再看到 max-age=0
#   就解除），真正的风险是**一年 max-age 生效期间 HTTPS 一旦挂掉，
#   浏览器会拒绝回退到明文** —— 等于把一次配置事故放大成一年。
#
#   ★ 忘了改成一年也不会有故障，只是 HSTS 的保护弱一些。
SECURE_HSTS_SECONDS=300

# HSTS 是否覆盖**所有子域**。
#
# ★ 填 False：含子域会把 example.com 下面**每一个**子域一起锁进 HTTPS。
#   如果这个域名以后还要给别的服务用（比如 panel.example.com 走 http），
#   含子域会让它们直接打不开，而且改回来要等 max-age 过期。
#
# ★ 只有当你确定这个域名及其所有子域永远只走 HTTPS 时，才改成 True。
SECURE_HSTS_INCLUDE_SUBDOMAINS=False


# ------------------------------------------------------------
# 后台地址
# ------------------------------------------------------------
# ★ 换成一个别人猜不到的路径（结尾要带斜杠）。
#   /admin/ 是所有扫描器的第一个探测目标，换掉之后它们连门都找不到。
#   改了之后记得用新地址访问后台。
ADMIN_URL_PATH=manage-8f3a91c7/


# ------------------------------------------------------------
# 数据库
# ------------------------------------------------------------
DB_ENGINE=mysql
DB_NAME=ai_content_agent
DB_USER=agent

# ★★★ 换成强密码。生成：openssl rand -base64 32 | tr -d '/+='
#
# ★ 密码里请**避开 $ 符号**：docker compose 会对 .env 做变量展开，
#   P@ss$word 里的 $word 会被当成变量替换成空字符串，密码就悄悄变了，
#   然后你会看到一个莫名其妙的"Access denied"。
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-another-strong-password

# ★ 这是 compose 里数据库服务的名字，**不是** 127.0.0.1。
#   容器之间通过服务名互相访问。写 127.0.0.1 会连到容器自己身上，必失败。
DB_HOST=db
DB_PORT=3306


# ------------------------------------------------------------
# 大模型
# ------------------------------------------------------------
# ★ 换模型 / 换厂商只需要改这几行，不用动任何代码。
#
# 注意：本项目依赖"工具调用 / function calling"能力。
#       DeepSeek 必须用 deepseek-chat（V3），
#       不要用 deepseek-reasoner（R1）—— R1 是推理模型，
#       不支持 function calling，Agent 会完全没法调用工具。
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
# 可留空：不影响网站启动和登录。用户登录后在「设置」配置并启用个人文字 API。
# 填写时作为未启用个人 API 的账号使用的服务器默认密钥。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1

LLM_TEMPERATURE=0.4
# 单次模型调用的超时（秒）。
# ★ 这个值要和**两层** nginx 的超时一起看：容器里的 nginx 是 600 秒，
#   前面的宝塔默认只有 60 秒 —— 宝塔那边不改大，长文生成会在宝塔就被切断，
#   容器里配多长都没用。见 README 12.10 第 2 步 ②。
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2


# ------------------------------------------------------------
# 联网搜索
# ------------------------------------------------------------
# 可选 tavily / google。
#
# ★ 推荐 Tavily：注册简单，只要一个凭据，自带英文索引。
#
# ★ 不要再选 Google 了：Google 已于 2026-01-20 取消「搜索整个网络」，
#   新建的搜索引擎最多只能覆盖 50 个域名；Custom Search JSON API
#   也不再接受新用户（2027-01-01 关停）。
#   这是账号级别的限制，改 API 限制、重新申请 Key、新建项目都没有用。
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_BASE_URL=https://api.tavily.com
SEARCH_TIMEOUT=20
SEARCH_LANGUAGE=


# ------------------------------------------------------------
# AI 配图（文生图）
# ------------------------------------------------------------
# 走 OpenAI 兼容的 /images/generations 协议，所以可以直接对接**中转站**
# （one-api / new-api 那一类）。
#
# ★ 三项缺一不可，代码刻意**不会**回退到 OpenAI 官方地址 ——
#   中转站域名每家都不同，给默认值只会让人更迷惑。
#   缺任何一项时不会 500，而是返回"缺了哪几项"的中文提示。
IMAGE_API_KEY=
IMAGE_BASE_URL=https://your-relay.example.com/v1
# ★ 必须是中转站支持的**生图**模型名，注意生图和对话是两套模型。
#   填错的症状：接口明确提示"模型不存在，请去中转站后台确认"。
IMAGE_MODEL=gpt-image-1

# 单张图的超时（秒）。生图要 30~90 秒，别往小调。
# ★ 同样受宝塔那层 60 秒默认超时的限制 —— 见 README 12.10 第 2 步 ②。
IMAGE_TIMEOUT=300
# 横版 —— settings.py 里画风提示词写了"构图为横版"，改一个就得改另一个。
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
IMAGE_OUTPUT_FORMAT=jpeg
# 画风前缀。★ 默认值（科技杂志编辑插画风）写在 config/settings.py 里，
#   这里留空/注释掉就用那个默认值；想换画风再在这里覆盖。
# ★ 只能单行，且别用 "#"（会被当注释吃掉）。
# IMAGE_STYLE_PROMPT=
# 单篇文章的配图上限。这是可读性约束（正文图太多很难读），不是防烧钱。
IMAGE_MAX_PER_ARTICLE=8
# ---- 配图的每日额度（★ 这条才是防烧钱的）----
# 和 AGENT_DAILY_QUOTA_* 同一套硬账本：直接数数据库里当天的真实行数，
# 清缓存 / 重启 / 换 worker 都绕不过去。
# ★ 一张图比一次文章生成便宜，但一篇配 5~8 张就反超了，
#   所以这两个数不要设得比文章额度宽太多。
IMAGE_DAILY_QUOTA_PER_USER=30
IMAGE_DAILY_QUOTA_GLOBAL=300
# 推送公众号的频率上限（每次推送都要真的调微信，微信侧有 45009 调用量上限）。
# ★ 只作用于推送，查推送历史不受影响。
THROTTLE_WECHAT_PUBLISH=30/hour


# ------------------------------------------------------------
# 微信公众号（推送草稿箱）
# ------------------------------------------------------------
# 公众号后台 → 设置与开发 → 基本配置 里拿这两个值。
#
# ★★★ 同一个页面里的 **IP 白名单**必须把服务器的公网 IP 加进去，
#      否则所有接口都会返回 40164。这是后台配置，代码层面无解，
#      而且最长 10 分钟才生效 —— 刚加完还报错是正常的，等一会儿再试。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TIMEOUT=60
# 草稿里的"作者"字段，填你的公众号名。留空就是不带作者，微信允许。
WECHAT_AUTHOR=

# ★ 这个功能做的是**建草稿**，不是发布。
#   个人主体订阅号从 2025-07 起拿不到 freepublish/submit 权限，
#   API 层面就发不出去：只能建草稿，由你在公众号后台手动点发布。
#   这和产品红线（V1 绝不自动发布）正好一致，不是配置没配对。


# ------------------------------------------------------------
# 防烧钱（★ 这一节看仔细，直接关系到你的钱包）
# ------------------------------------------------------------
# ★ 关掉自助注册。
#   开着的话，公网上的陌生人注册之后就能用**你的** LLM_API_KEY 生成文章，
#   这钱是你出的。关掉之后账号由管理员创建：
#       docker compose exec backend python manage.py createsuperuser
#   之后也可以在后台继续加人。
ALLOW_REGISTRATION=False

# ---- 第一层：频率限流（挡"短时间狂点"）----
# 单用户提交生成的频率。别设太紧 —— 一次生成要跑 30~120 秒，
# 用户在等待期间刷新页面、点开历史列表都不该被误伤。
THROTTLE_GENERATE=10/hour
# 登录接口，防撞库
THROTTLE_LOGIN=20/min

# ---- 第二、三层：每日总量额度（挡"慢慢烧"）----
# ★ 这才是真正的钱包保险丝。
#
#   把额度刷光最典型的姿势不是"疯狂点按钮"（那会被上面的频率限流挡住），
#   而是"每天正常用，但每次都跑满 8 次工具调用 + 十几次大模型调用" ——
#   频率完全正常，只有自然日的总量账本挡得住。
#
#   这两个数字是"数数据库里真实有几条运行记录"，清缓存、重启、换 worker
#   都绕不过去，也没法用注册小号绕过（全局那条是算所有人的）。
#
#   0 = 不限制。按你的心理止损线来设。
#   单人每天最多生成几篇
AGENT_DAILY_QUOTA_PER_USER=20
# 全站每天总上限 —— 最坏情况下的损失上限就是这个数
AGENT_DAILY_QUOTA_GLOBAL=200


# ------------------------------------------------------------
# 缓存
# ------------------------------------------------------------
# locmem = 每个 gunicorn worker 各存一份限流计数。
#
# ★ 为什么不影响防烧钱：真正的保险丝是上面那两个每日额度，
#   它们直接数数据库行数，跟缓存完全无关，多 worker 也是准的。
#   频率限流只是第一道粗筛，内存版足够。
#
# 要精确的跨进程频率限流就改成 db（容器启动时会自动建表），
# 或者换成 Redis。改这一个值即可，代码不用动。
CACHES_BACKEND=locmem


# ------------------------------------------------------------
# Agent 运行限制（一般不用改）
# ------------------------------------------------------------
MAX_TOOL_CALLS=8
MAX_SEARCH_RESULTS=5
MAX_WEBPAGE_CHARS=20000
MAX_USER_PROMPT_CHARS=5000
AGENT_RECURSION_LIMIT=30
WEBPAGE_FETCH_TIMEOUT=15
WEBPAGE_MAX_BYTES=2000000
WEBPAGE_MAX_REDIRECTS=3


# ------------------------------------------------------------
# 日志
# ------------------------------------------------------------
LOG_LEVEL=INFO


# ------------------------------------------------------------
# 跨平台热点选题
# ------------------------------------------------------------
# 调度器每 6 小时采集一次；只有一个活跃用户时可自动确定归属。
TREND_INTERVAL_SECONDS=21600
# 首轮在后端健康后立即执行；此值是每轮完成后的等待秒数，最小 900。
# backend 与调度器均读取本文件；Compose 固定数据库连接为 mysql / db:3306。
TREND_GOOGLE_GEO=US
TREND_GITHUB_TOKEN=
TREND_GITEE_TOKEN=
TREND_YOUTUBE_REGION=US
TREND_YOUTUBE_API_KEY=
TREND_X_WOEID=1
TREND_X_BEARER_TOKEN=
# 抖音应用还须在开放平台申请 hotsearch 权限。
TREND_DOUYIN_CLIENT_KEY=
TREND_DOUYIN_CLIENT_SECRET=
# 建议填写账号领域，例如 AI,科技,人工智能；留空则候选覆盖全部热点。
TREND_KEYWORDS=
# 多用户时填写用户名，逗号分隔；每个账号有自己的每日出稿上限。
# 例：TREND_USERNAMES=user1,user2
TREND_USERNAMES=
TREND_USER_ID=0
TREND_AUTO_GENERATE=True
TREND_DAILY_ARTICLE_LIMIT=1
TREND_FETCH_TIMEOUT=15
THROTTLE_TREND_REFRESH=3/hour

# Optional independent encryption secret for per-account model API keys.
# Keep stable and back it up with the database. Blank uses SECRET_KEY.
MODEL_CREDENTIAL_SECRET=
